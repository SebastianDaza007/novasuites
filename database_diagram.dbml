// ============================================
// SISTEMA DE GESTIÓN HOTELERA - NOVASUITES
// Diagrama de Base de Datos Completo
// ============================================

// ============================================
// SPRINT 1 - GESTIÓN DE INVENTARIO Y COMPRAS
// ============================================

// Enums existentes
Enum "estados_factura" {
  "PENDIENTE"
  "PAGADA"
  "VENCIDA"
  "ANULADA"
}

Enum "estados_orden" {
  "PENDIENTE"
  "APROBADA"
  "RECIBIDA"
  "CANCELADA"
}

Enum "tipo_factura" {
  "A"
  "B"
  "C"
}

Enum "tipos_movimiento" {
  "ALTA"
  "BAJA"
  "TRANSFERENCIA_SALIDA"
  "TRANSFERENCIA_ENTRADA"
  "AJUSTE"
}

// Tablas existentes
Table "categoria" {
  "id_categoria" integer [pk, not null, increment]
  "nombre_categoria" text [not null]
  "descripcion_categoria" text
  "activo" boolean [not null, default: true]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
}

Table "deposito" {
  "id_deposito" integer [pk, not null, increment]
  "nombre_deposito" text [not null]
  "telefono_deposito" integer
  "direccion_deposito" text
  "activo" boolean [not null, default: true]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "id_responsable" integer
}

Table "detalle_factura_proveedor" {
  "id_detalle_factura" integer [pk, not null, increment]
  "cantidad" integer [not null]
  "id_factura" integer [not null]
  "id_insumo" integer [not null]
  "precio" numeric(10,2) [not null, default: 0.00]
}

Table "detalle_movimiento_inventario" {
  "id_detalle" integer [pk, not null, increment]
  "cantidad" integer [not null]
  "lote" text
  "fecha_vencimiento" timestamp(6)
  "id_movimiento" integer [not null]
  "id_insumo" integer [not null]
}

Table "detalle_orden_compra" {
  "id_detalle_orden" integer [pk, not null, increment]
  "cantidad_solicitada" integer [not null]
  "id_orden_compra" integer [not null]
  "id_insumo" integer [not null]
}

Table "factura_proveedor" {
  "id_factura" integer [pk, not null, increment]
  "numero_factura" text [not null]
  "tipo" tipo_factura [not null]
  "fecha_emision" timestamp(6) [not null]
  "fecha_vencimiento" timestamp(6) [not null]
  "estado_factura" estados_factura [not null, default: `PENDIENTE`]
  "observaciones" text
  "fecha_pago" timestamp(6) [note: 'PENDIENTE: Agregar en Sprint 1.5']
  "metodo_pago" text [note: 'PENDIENTE: Agregar en Sprint 1.5 - transferencia, efectivo, cheque, etc']
  "monto_pagado" numeric(10,2) [note: 'PENDIENTE: Agregar en Sprint 1.5']
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)
  "id_proveedor" integer [not null]
  "id_orden_compra" integer

  Indexes {
    numero_factura [type: btree, unique, name: "factura_proveedor_numero_factura_key"]
  }
}

Table "insumo" {
  "id_insumo" integer [pk, not null, increment]
  "nombre_insumo" text [not null]
  "descripcion_insumo" text
  "activo" boolean [not null, default: true]
  "fecha_actualizacion" timestamp(6)
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "id_categoria" integer [not null]
}

Table "insumo_proveedor" {
  "id_insumo_proveedor" integer [pk, not null, increment]
  "id_insumo" integer
  "id_proveedor" integer
}

Table "movimiento_inventario" {
  "id_movimiento" integer [pk, not null, increment]
  "fecha_movimiento" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "numero_comprobante" text
  "observaciones" text
  "id_deposito" integer
  "id_orden_compra" integer
  "id_razon_movimiento" integer
  "id_usuario" integer [not null]
}

Table "orden_compra" {
  "id_orden_compra" integer [pk, not null, increment]
  "numero_orden" text [not null]
  "fecha_orden" timestamp(6) [not null, default: `CURRENT_TIMESTAMP`]
  "fecha_entrega_estimada" timestamp(6) [not null]
  "estado_orden" estados_orden [not null, default: `PENDIENTE`]
  "observaciones" text
  "fecha_actualizacion" timestamp(6)
  "id_proveedor" integer [not null]
  "id_usuario_solicita" integer [not null]

  Indexes {
    numero_orden [type: btree, unique, name: "orden_compra_numero_orden_key"]
  }
}

Table "proveedor" {
  "id_proveedor" integer [pk, not null, increment]
  "nombre_proveedor" text [not null]
  "cuit_proveedor" text [not null]
  "direccion_proveedor" text [not null]
  "telefono_proveedor" integer
  "correo_proveedor" text
  "nombre_responsable" text
  "contacto_responsable" integer
  "activo" boolean [not null, default: true]
  "observaciones" text
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)

  Indexes {
    cuit_proveedor [type: btree, unique, name: "proveedor_cuit_proveedor_key"]
  }
}

Table "razon_movimiento" {
  "id_razon" integer [pk, not null, increment]
  "nombre_razon" text [not null]
  "descripcion" text
  "tipo_movimiento" tipos_movimiento [not null]
}

Table "rol" {
  "id" integer [pk, not null, increment]
  "nombre" text [not null]

  Indexes {
    nombre [type: btree, unique, name: "rol_nombre_key"]
  }
}

Table "stock_deposito" {
  "id_stock" integer [pk, not null, increment]
  "cantidad_actual" integer [not null, default: 0]
  "stock_minimo" integer [not null, default: 0]
  "stock_critico" integer [not null, default: 0]
  "stock_maximo" integer [not null, default: 0]
  "fecha_ultimo_mov" timestamp(6)
  "id_deposito" integer [not null]
  "id_insumo" integer [not null]

  Indexes {
    (id_deposito, id_insumo) [type: btree, unique, name: "stock_deposito_id_deposito_id_insumo_idx"]
  }
}

Table "usuario" {
  "id" integer [pk, not null, increment]
  "email" text [not null]
  "contrasena" text [not null]
  "activo" boolean [not null, default: true]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)
  "id_rol" integer [not null]

  Indexes {
    email [type: btree, unique, name: "usuario_email_key"]
  }
}

// ============================================
// SPRINT 1.5 - NOTAS DE CRÉDITO/DÉBITO PROVEEDORES
// ============================================

Enum "tipo_nota_proveedor" {
  "CREDITO"
  "DEBITO"
  note: 'PENDIENTE: Crear en Sprint 1.5'
}

Table "nota_credito_debito_proveedor" {
  "id_nota" integer [pk, not null, increment]
  "numero_nota" text [not null, note: 'Formato: NC-00000001 o ND-00000001']
  "tipo_nota" tipo_nota_proveedor [not null]
  "fecha_emision" timestamp(6) [not null]
  "monto" numeric(10,2) [not null]
  "motivo" text [not null, note: 'descuento, devolucion, servicios_adicionales, etc']
  "observaciones" text
  "id_factura" integer [not null, note: 'FK a factura_proveedor']
  "id_usuario" integer [note: 'Usuario que generó la nota']
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]

  Indexes {
    numero_nota [type: btree, unique, name: "nota_proveedor_numero_nota_key"]
  }

  note: 'PENDIENTE: Crear tabla en Sprint 1.5'
}

// ============================================
// SPRINT 2 - GESTIÓN HOTELERA
// ============================================

// Enums para gestión hotelera
Enum "tipo_habitacion" {
  "SINGLE"
  "DOBLE"
  "SUITE"
  "TRIPLE"
  "FAMILIAR"
}

Enum "estado_habitacion" {
  "DISPONIBLE"
  "OCUPADA"
  "LIMPIEZA"
  "MANTENIMIENTO"
  "RESERVADA"
}

Enum "estado_reserva" {
  "RESERVADA"
  "CONFIRMADA"
  "CHECKIN"
  "CHECKOUT"
  "CANCELADA"
  "NO_SHOW"
}

Enum "tipo_documento" {
  "DNI"
  "PASAPORTE"
  "CUIT"
  "CUIL"
}

Enum "tipo_tarea_housekeeping" {
  "LIMPIEZA"
  "REPOSICION"
  "MANTENIMIENTO"
  "INSPECCION"
}

Enum "estado_tarea_housekeeping" {
  "PENDIENTE"
  "EN_PROCESO"
  "COMPLETADA"
  "CANCELADA"
}

Enum "metodo_pago_venta" {
  "EFECTIVO"
  "TARJETA_CREDITO"
  "TARJETA_DEBITO"
  "TRANSFERENCIA"
  "CHEQUE"
  "MERCADOPAGO"
}

Enum "tipo_servicio" {
  "ALOJAMIENTO"
  "LAVANDERIA"
  "ROOM_SERVICE"
  "MINIBAR"
  "DESAYUNO"
  "AMENITIES"
  "PARKING"
  "TRASLADO"
  "OTROS"
}

// Tablas de gestión hotelera
Table "habitacion" {
  "id_habitacion" integer [pk, not null, increment]
  "numero_habitacion" text [not null, unique]
  "piso" integer
  "tipo_habitacion" tipo_habitacion [not null]
  "capacidad_personas" integer [not null]
  "precio_base" numeric(12,2) [not null]
  "descripcion" text
  "estado" estado_habitacion [not null, default: `DISPONIBLE`]
  "activo" boolean [not null, default: true]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)

  Indexes {
    numero_habitacion [type: btree, unique, name: "habitacion_numero_key"]
  }
}

Table "caracteristica_habitacion" {
  "id_caracteristica" integer [pk, not null, increment]
  "nombre" text [not null, note: 'Wifi, TV, Aire Acondicionado, etc']
  "descripcion" text
}

Table "habitacion_caracteristica" {
  "id" integer [pk, not null, increment]
  "id_habitacion" integer [not null]
  "id_caracteristica" integer [not null]

  Indexes {
    (id_habitacion, id_caracteristica) [type: btree, unique, name: "habitacion_caracteristica_unique"]
  }
}

Table "huesped" {
  "id_huesped" integer [pk, not null, increment]
  "nombre" text [not null]
  "apellido" text [not null]
  "tipo_documento" tipo_documento [not null]
  "numero_documento" text [not null]
  "fecha_nacimiento" date
  "nacionalidad" text
  "telefono" text
  "email" text
  "direccion" text
  "ciudad" text
  "pais" text
  "observaciones" text
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)

  Indexes {
    (tipo_documento, numero_documento) [type: btree, unique, name: "huesped_documento_unique"]
  }
}

Table "reserva" {
  "id_reserva" integer [pk, not null, increment]
  "numero_reserva" text [not null, unique, note: 'Formato: RES-00000001']
  "id_habitacion" integer [not null]
  "id_huesped_principal" integer [not null, note: 'Huésped titular de la reserva']
  "fecha_checkin" date [not null]
  "fecha_checkout" date [not null]
  "hora_checkin_estimada" time
  "hora_checkout_estimada" time
  "cantidad_personas" integer [not null]
  "cantidad_adultos" integer [not null]
  "cantidad_ninos" integer [default: 0]
  "precio_por_noche" numeric(12,2) [not null]
  "precio_total" numeric(12,2) [not null]
  "anticipo" numeric(12,2) [default: 0]
  "estado" estado_reserva [not null, default: `RESERVADA`]
  "observaciones" text
  "motivo_cancelacion" text
  "fecha_checkin_real" timestamp(6)
  "fecha_checkout_real" timestamp(6)
  "id_usuario_crea" integer [not null]
  "id_usuario_checkin" integer
  "id_usuario_checkout" integer
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)

  Indexes {
    numero_reserva [type: btree, unique, name: "reserva_numero_key"]
  }
}

Table "reserva_huesped" {
  "id" integer [pk, not null, increment]
  "id_reserva" integer [not null]
  "id_huesped" integer [not null]
  "es_titular" boolean [not null, default: false]

  Indexes {
    (id_reserva, id_huesped) [type: btree, unique, name: "reserva_huesped_unique"]
  }
}

Table "tarea_housekeeping" {
  "id_tarea" integer [pk, not null, increment]
  "id_habitacion" integer [not null]
  "fecha_programada" date [not null]
  "hora_inicio" timestamp(6)
  "hora_fin" timestamp(6)
  "tipo_tarea" tipo_tarea_housekeeping [not null]
  "prioridad" integer [default: 1, note: '1=Baja, 2=Media, 3=Alta, 4=Urgente']
  "estado" estado_tarea_housekeeping [not null, default: `PENDIENTE`]
  "observaciones" text
  "notas_completado" text
  "id_usuario_asignado" integer
  "id_usuario_crea" integer [not null]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)
}

Table "insumo_housekeeping" {
  "id" integer [pk, not null, increment]
  "id_tarea" integer [not null]
  "id_insumo" integer [not null]
  "cantidad_utilizada" integer [not null]
  "observaciones" text

  note: 'Registro de insumos consumidos en tareas de housekeeping'
}

Table "factura_venta" {
  "id_factura" integer [pk, not null, increment]
  "numero_factura" text [not null, unique]
  "tipo" tipo_factura [not null]
  "id_reserva" integer
  "id_huesped" integer [not null]
  "fecha_emision" timestamp(6) [not null]
  "fecha_vencimiento" timestamp(6) [not null]
  "subtotal" numeric(12,2) [not null]
  "iva" numeric(12,2) [default: 0]
  "descuento" numeric(12,2) [default: 0]
  "total" numeric(12,2) [not null]
  "estado" estados_factura [not null, default: `PENDIENTE`]
  "observaciones" text
  "id_usuario_crea" integer [not null]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "fecha_actualizacion" timestamp(6)

  Indexes {
    numero_factura [type: btree, unique, name: "factura_venta_numero_key"]
  }
}

Table "detalle_factura_venta" {
  "id_detalle" integer [pk, not null, increment]
  "id_factura" integer [not null]
  "tipo_servicio" tipo_servicio [not null]
  "descripcion" text [not null]
  "cantidad" numeric(10,2) [not null]
  "precio_unitario" numeric(12,2) [not null]
  "subtotal" numeric(12,2) [not null]
  "iva_porcentaje" numeric(5,2) [default: 0]
  "iva_monto" numeric(12,2) [default: 0]
  "descuento" numeric(12,2) [default: 0]
  "total" numeric(12,2) [not null]
  "fecha_servicio" date
}

Table "pago_factura_venta" {
  "id_pago" integer [pk, not null, increment]
  "id_factura" integer [not null]
  "fecha_pago" timestamp(6) [not null]
  "monto" numeric(12,2) [not null]
  "metodo_pago" metodo_pago_venta [not null]
  "numero_comprobante" text
  "observaciones" text
  "id_usuario_registra" integer [not null]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
}

Table "nota_credito_venta" {
  "id_nota" integer [pk, not null, increment]
  "numero_nota" text [not null, unique, note: 'Formato: NC-V-00000001']
  "id_factura" integer [not null]
  "fecha_emision" timestamp(6) [not null]
  "monto" numeric(12,2) [not null]
  "motivo" text [not null]
  "observaciones" text
  "id_usuario_genera" integer [not null]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]

  Indexes {
    numero_nota [type: btree, unique, name: "nota_credito_venta_numero_key"]
  }
}

Table "nota_debito_venta" {
  "id_nota" integer [pk, not null, increment]
  "numero_nota" text [not null, unique, note: 'Formato: ND-V-00000001']
  "id_factura" integer [not null]
  "fecha_emision" timestamp(6) [not null]
  "monto" numeric(12,2) [not null]
  "motivo" text [not null]
  "observaciones" text
  "id_usuario_genera" integer [not null]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]

  Indexes {
    numero_nota [type: btree, unique, name: "nota_debito_venta_numero_key"]
  }
}

// ============================================
// SPRINT 3 - FUNCIONALIDADES ADICIONALES
// ============================================

Enum "tipo_tarifa" {
  "TEMPORADA_BAJA"
  "TEMPORADA_MEDIA"
  "TEMPORADA_ALTA"
  "EVENTO_ESPECIAL"
  "CORPORATIVA"
  "PROMOCIONAL"
}

Enum "canal_reserva" {
  "DIRECTO"
  "TELEFONO"
  "EMAIL"
  "BOOKING"
  "AIRBNB"
  "EXPEDIA"
  "DESPEGAR"
  "AGENCIA"
}

Table "tarifa" {
  "id_tarifa" integer [pk, not null, increment]
  "id_habitacion" integer [not null]
  "tipo_tarifa" tipo_tarifa [not null]
  "precio" numeric(12,2) [not null]
  "fecha_inicio" date [not null]
  "fecha_fin" date [not null]
  "activo" boolean [not null, default: true]
  "descripcion" text
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
}

Table "canal_reserva_config" {
  "id" integer [pk, not null, increment]
  "canal" canal_reserva [not null, unique]
  "comision_porcentaje" numeric(5,2) [default: 0]
  "activo" boolean [not null, default: true]
  "configuracion_json" text [note: 'Configuración específica del canal en JSON']
}

Table "reserva_canal" {
  "id" integer [pk, not null, increment]
  "id_reserva" integer [not null]
  "canal" canal_reserva [not null]
  "codigo_externo" text [note: 'ID de reserva en plataforma externa']
  "comision" numeric(12,2) [default: 0]
}

Table "mantenimiento_habitacion" {
  "id_mantenimiento" integer [pk, not null, increment]
  "id_habitacion" integer [not null]
  "fecha_inicio" timestamp(6) [not null]
  "fecha_fin_estimada" timestamp(6)
  "fecha_fin_real" timestamp(6)
  "tipo_mantenimiento" text [not null, note: 'Preventivo, Correctivo, etc']
  "descripcion" text [not null]
  "costo" numeric(12,2)
  "proveedor" text
  "estado" text [not null, default: `PENDIENTE`]
  "id_usuario_solicita" integer [not null]
  "fecha_creacion" timestamp(6) [default: `CURRENT_TIMESTAMP`]
}

Table "auditoria_cambios" {
  "id_auditoria" integer [pk, not null, increment]
  "tabla" text [not null]
  "id_registro" integer [not null]
  "accion" text [not null, note: 'INSERT, UPDATE, DELETE']
  "datos_anteriores" text [note: 'JSON con datos previos']
  "datos_nuevos" text [note: 'JSON con datos nuevos']
  "id_usuario" integer [not null]
  "fecha" timestamp(6) [default: `CURRENT_TIMESTAMP`]
  "ip_origen" text
}

// ============================================
// RELACIONES - SPRINT 1
// ============================================

Ref "deposito_id_responsable_fkey":"usuario"."id" < "deposito"."id_responsable"
Ref "detalle_factura_proveedor_id_factura_fkey":"factura_proveedor"."id_factura" < "detalle_factura_proveedor"."id_factura"
Ref "detalle_factura_proveedor_id_insumo_fkey":"insumo"."id_insumo" < "detalle_factura_proveedor"."id_insumo"
Ref "detalle_movimiento_inventario_id_insumo_fkey":"insumo"."id_insumo" < "detalle_movimiento_inventario"."id_insumo"
Ref "detalle_movimiento_inventario_id_movimiento_fkey":"movimiento_inventario"."id_movimiento" < "detalle_movimiento_inventario"."id_movimiento"
Ref "detalle_orden_compra_id_insumo_fkey":"insumo"."id_insumo" < "detalle_orden_compra"."id_insumo"
Ref "detalle_orden_compra_id_orden_compra_fkey":"orden_compra"."id_orden_compra" < "detalle_orden_compra"."id_orden_compra"
Ref "factura_proveedor_id_orden_compra_fkey":"orden_compra"."id_orden_compra" < "factura_proveedor"."id_orden_compra"
Ref "factura_proveedor_id_proveedor_fkey":"proveedor"."id_proveedor" < "factura_proveedor"."id_proveedor"
Ref "insumo_id_categoria_fkey":"categoria"."id_categoria" < "insumo"."id_categoria"
Ref "insumo_proveedor_id_insumo_fkey":"insumo"."id_insumo" < "insumo_proveedor"."id_insumo"
Ref "insumo_proveedor_id_proveedor_fkey":"proveedor"."id_proveedor" < "insumo_proveedor"."id_proveedor"
Ref "movimiento_inventario_id_deposito_fkey":"deposito"."id_deposito" < "movimiento_inventario"."id_deposito"
Ref "movimiento_inventario_id_orden_compra_fkey":"orden_compra"."id_orden_compra" < "movimiento_inventario"."id_orden_compra"
Ref "movimiento_inventario_id_razon_movimiento_fkey":"razon_movimiento"."id_razon" < "movimiento_inventario"."id_razon_movimiento"
Ref "movimiento_inventario_id_usuario_fkey":"usuario"."id" < "movimiento_inventario"."id_usuario"
Ref "orden_compra_id_proveedor_fkey":"proveedor"."id_proveedor" < "orden_compra"."id_proveedor"
Ref "orden_compra_id_usuario_solicita_fkey":"usuario"."id" < "orden_compra"."id_usuario_solicita"
Ref "stock_deposito_id_deposito_fkey":"deposito"."id_deposito" < "stock_deposito"."id_deposito"
Ref "stock_deposito_id_insumo_fkey":"insumo"."id_insumo" < "stock_deposito"."id_insumo"
Ref "usuario_id_rol_fkey":"rol"."id" < "usuario"."id_rol"

// ============================================
