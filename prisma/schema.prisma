generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categoria {
  id_categoria          Int       @id @default(autoincrement())
  nombre_categoria      String
  descripcion_categoria String?
  activo                Boolean   @default(true)
  fecha_creacion        DateTime? @default(now()) @db.Timestamp(6)
  insumos               insumo[]
}

model insumo {
  id_insumo                 Int                             @id @default(autoincrement())
  nombre_insumo             String
  descripcion_insumo        String?
  activo                    Boolean                         @default(true)
  fecha_actualizacion       DateTime?                       @updatedAt @db.Timestamp(6)
  fecha_creacion            DateTime?                       @default(now()) @db.Timestamp(6)
  id_categoria              Int
  detalle_factura_proveedor detalle_factura_proveedor[]
  detalle_movimientos       detalle_movimiento_inventario[]
  detalle_ordenes           detalle_orden_compra[]
  categoria                 categoria                       @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
  insumo_proveedor          insumo_proveedor[]
  stock_depositos           stock_deposito[]
}

model proveedor {
  id_proveedor         Int                 @id @default(autoincrement())
  nombre_proveedor     String
  cuit_proveedor       String              @unique
  direccion_proveedor  String
  telefono_proveedor   Int?
  correo_proveedor     String?
  nombre_responsable   String?
  contacto_responsable Int?
  activo               Boolean             @default(true)
  observaciones        String?
  fecha_creacion       DateTime?           @default(now()) @db.Timestamp(6)
  fecha_actualizacion  DateTime?           @updatedAt @db.Timestamp(6)
  facturas             factura_proveedor[]
  insumo_proveedor     insumo_proveedor[]
  ordenes_compra       orden_compra[]
}

model deposito {
  id_deposito           Int                     @id @default(autoincrement())
  nombre_deposito       String
  telefono_deposito     Int?
  direccion_deposito    String?
  activo                Boolean                 @default(true)
  fecha_creacion        DateTime?               @default(now()) @db.Timestamp(6)
  id_responsable        Int?
  usuario               usuario?                @relation(fields: [id_responsable], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movimiento_inventario movimiento_inventario[]
  stock_depositos       stock_deposito[]
}

model stock_deposito {
  id_stock         Int       @id @default(autoincrement())
  cantidad_actual  Int       @default(0)
  stock_minimo     Int       @default(0)
  stock_critico    Int       @default(0)
  stock_maximo     Int       @default(0)
  fecha_ultimo_mov DateTime? @db.Timestamp(6)
  id_deposito      Int
  id_insumo        Int
  deposito         deposito  @relation(fields: [id_deposito], references: [id_deposito], onDelete: NoAction, onUpdate: NoAction)
  insumo           insumo    @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_deposito, id_insumo], map: "stock_deposito_id_deposito_id_insumo_idx")
}

model razon_movimiento {
  id_razon        Int                     @id @default(autoincrement())
  nombre_razon    String
  descripcion     String?
  tipo_movimiento tipos_movimiento
  movimientos     movimiento_inventario[]
}

model movimiento_inventario {
  id_movimiento       Int                             @id @default(autoincrement())
  fecha_movimiento    DateTime?                       @default(now()) @db.Timestamp(6)
  numero_comprobante  String?
  observaciones       String?
  id_deposito         Int?
  id_orden_compra     Int?
  id_razon_movimiento Int?
  id_usuario          Int
  detalles            detalle_movimiento_inventario[]
  deposito            deposito?                       @relation(fields: [id_deposito], references: [id_deposito], onDelete: NoAction, onUpdate: NoAction)
  orden_compra        orden_compra?                   @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: NoAction, onUpdate: NoAction)
  razon_movimiento    razon_movimiento?               @relation(fields: [id_razon_movimiento], references: [id_razon], onDelete: NoAction, onUpdate: NoAction)
  usuario             usuario                         @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_movimiento_inventario {
  id_detalle        Int                   @id @default(autoincrement())
  cantidad          Int
  lote              String?
  fecha_vencimiento DateTime?             @db.Timestamp(6)
  id_movimiento     Int
  id_insumo         Int
  insumo            insumo                @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  movimiento        movimiento_inventario @relation(fields: [id_movimiento], references: [id_movimiento], onDelete: NoAction, onUpdate: NoAction)
}

model orden_compra {
  id_orden_compra        Int                     @id @default(autoincrement())
  numero_orden           String                  @unique
  fecha_orden            DateTime                @default(now()) @db.Timestamp(6)
  fecha_entrega_estimada DateTime               @db.Timestamp(6)
  estado_orden           estados_orden           @default(PENDIENTE)
  observaciones          String?
  fecha_actualizacion    DateTime?               @updatedAt @db.Timestamp(6)
  id_proveedor           Int
  id_usuario_solicita    Int
  detalles               detalle_orden_compra[]
  facturas               factura_proveedor[]
  movimientos            movimiento_inventario[]
  proveedor              proveedor               @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
  usuario_solicita       usuario                 @relation(fields: [id_usuario_solicita], references: [id], onDelete: NoAction, onUpdate: NoAction)

}


model detalle_orden_compra {
  id_detalle_orden    Int          @id @default(autoincrement())
  cantidad_solicitada Int
  id_orden_compra     Int
  id_insumo           Int
  insumo              insumo       @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  orden_compra        orden_compra @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: NoAction, onUpdate: NoAction)
}

model factura_proveedor {
  id_factura                Int                         @id @default(autoincrement())
  numero_factura            String                      @unique
  tipo                      tipo_factura
  fecha_emision             DateTime                    @db.Timestamp(6)
  fecha_vencimiento         DateTime                    @db.Timestamp(6)
  estado_factura            estados_factura             @default(PENDIENTE)
  observaciones             String?
  fecha_creacion            DateTime?                   @default(now()) @db.Timestamp(6)
  fecha_actualizacion       DateTime?                   @updatedAt @db.Timestamp(6)
  id_proveedor              Int
  id_orden_compra           Int?

  // 🔹 NUEVO: ahora cada factura puede vincularse directamente a una orden de pago
  id_orden_pago             Int?

  detalle_factura_proveedor detalle_factura_proveedor[]
  notas_credito notas_credito[]
  notas_debito  notas_debito[]
  orden_compra              orden_compra?               @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: NoAction, onUpdate: NoAction)
  proveedor                 proveedor                   @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)

// 🔹 NUEVA RELACION: factura_proveedor -> ordenes_pago
  orden_pago ordenes_pago? @relation(fields: [id_orden_pago], references: [id_ordenes_pago], onDelete: NoAction, onUpdate: NoAction)

}

model detalle_factura_proveedor {
  id_detalle_factura Int               @id @default(autoincrement())
  precio             Decimal           @db.Decimal(10,2) @default(0.00)
  cantidad           Int
  id_factura         Int
  id_insumo          Int
  factura_proveedor  factura_proveedor @relation(fields: [id_factura], references: [id_factura], onDelete: NoAction, onUpdate: NoAction)
  insumo             insumo            @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
}

model insumo_proveedor {
  id_insumo_proveedor Int        @id @default(autoincrement())
  id_insumo           Int?
  id_proveedor        Int?
  insumo              insumo?    @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  proveedor           proveedor? @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
}

model rol {
  id      Int       @id @default(autoincrement())
  nombre  String    @unique
  usuario usuario[]
}

model usuario {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  contrasena             String
  activo                 Boolean                 @default(true)
  fecha_creacion         DateTime?               @default(now()) @db.Timestamp(6)
  fecha_actualizacion    DateTime?               @db.Timestamp(6)
  id_rol                 Int
  deposito               deposito[]
  movimientos_inventario movimiento_inventario[]
  ordenes_compra         orden_compra[]
  housekeeping           housekeeping[]
  rol                    rol                     @relation(fields: [id_rol], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum estados_factura {
  PENDIENTE
  PAGADA
  VENCIDA
  ANULADA
}

enum estados_orden {
  PENDIENTE
  APROBADA
  RECIBIDA
  CANCELADA
}

enum tipo_factura {
  A
  B
  C
}

enum tipos_movimiento {
  ALTA
  BAJA
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  AJUSTE
}

// 🔹 Huespedes
model huespedes {
  id_huespedes Int    @id @default(autoincrement())
  nombre      String
  apellido    String
  documento   String
  telefono    String?
  email       String?

  reservas    reservas[]
  tarjetas     tarjeta_huesped[]
}

// 🔹 Habitaciones
model habitaciones {
  id_habitaciones Int    @id @default(autoincrement())
  numero          String @unique
  tipo            tipo_habitacion
  capacidad       Int
  precio_base     Decimal @db.Decimal(12,2)
  estado          estado_habitacion

  reservas_habitaciones reservas_habitaciones[]
  housekeeping          housekeeping[]
}

// 🔹 Reservas
model reservas {
  id_reservas      Int       @id @default(autoincrement())
  id_huesped       Int
  id_metodo_pago Int?
  id_tarjeta Int?            @unique
  fecha_checkin    DateTime  @db.Date
  fecha_checkout   DateTime  @db.Date
  cantidad_adultos Int   @default(1)
  cantidad_menores Int   @default(0)
  estado           estado_reservacion
  monto_total      Decimal   @db.Decimal(12,2)
  fecha_creacion   DateTime? @default(now())
  fecha_actualizacion   DateTime? @updatedAt

  metodo_pago    metodo_pago? @relation(fields: [id_metodo_pago], references: [id_metodo])
  huesped        huespedes    @relation(fields: [id_huesped], references: [id_huespedes])
  tarjeta        tarjeta_huesped? @relation(name: "ReservaTarjeta", fields: [id_tarjeta], references: [id_tarjeta]) // ✅ lado dueño
  reservas_habitaciones reservas_habitaciones[]
  facturas_ventas  facturas_ventas[]
  //acompañantes de la reserva (si aplica)
  acompanantes acompanante[]

}

model acompanante {
  id_acompanante   Int       @id @default(autoincrement())
  nombre           String
  apellido         String
  dni              String
  fecha_nacimiento DateTime  @db.Date
  id_reserva       Int

  // Relación con la reserva principal
  reserva reservas @relation(fields: [id_reserva], references: [id_reservas], onDelete: Cascade)

  fecha_creacion   DateTime? @default(now())
}


// 🔹 Reservas_Habitaciones (intermedia para N:N)
model reservas_habitaciones {
  id_reservas_habitaciones Int @id @default(autoincrement())
  id_reserva               Int
  id_habitacion            Int
  cantidad_personas        Int

  reserva    reservas    @relation(fields: [id_reserva], references: [id_reservas])
  habitacion habitaciones @relation(fields: [id_habitacion], references: [id_habitaciones])

  @@unique([id_reserva, id_habitacion])
}

// 🔹 Housekeeping
model housekeeping {
  id_housekeeping Int      @id @default(autoincrement())
  id_habitacion   Int
  fecha           DateTime @db.Date
  tarea           String
  estado          String
  observaciones   String?
  asignado_a      Int
  creado_en       DateTime? @default(now())

  habitacion habitaciones @relation(fields: [id_habitacion], references: [id_habitaciones])
  usuario     usuario     @relation(fields: [asignado_a], references: [id])
}

// 🔹 Facturas de ventas (clientes)
model facturas_ventas {
  id_facturas_ventas Int     @id @default(autoincrement())
  numero            String   @unique
  id_reserva        Int
  fecha_emision     DateTime @db.Date
  fecha_vencimiento DateTime @db.Date
  monto_total       Decimal  @db.Decimal(12,2)
  estado            estados_factura
  creado_en         DateTime? @default(now())
  actualizado_en    DateTime?

  reserva reservas          @relation(fields: [id_reserva], references: [id_reservas])
  detalles detalle_facturas_ventas[]
}

model detalle_facturas_ventas {
  id_detalle_facturas_ventas Int      @id @default(autoincrement())
  id_factura          Int
  descripcion         String
  cantidad            Decimal   @db.Decimal(10,2)
  precio_unitario     Decimal   @db.Decimal(12,2)

  factura facturas_ventas @relation(fields: [id_factura], references: [id_facturas_ventas])
}

model metodo_pago {
  id_metodo       Int     @id @default(autoincrement())
  nombre_metodo   String
  activo          Boolean @default(true)
  reservas        reservas[]
}

model tarjeta_huesped {
  id_tarjeta      Int     @id @default(autoincrement())
  id_huesped      Int
  numero_tarjeta  String
  titular_tarjeta        String
  fecha_expiracion DateTime @db.Date
  codigo_seguridad Int

  huesped  huespedes @relation(fields: [id_huesped], references: [id_huespedes])
  reserva  reservas? @relation(name: "ReservaTarjeta") // ✅ sin fields ni references
}

// 🔹 Notas de crédito
model notas_credito {
  id_notas_credito Int    @id @default(autoincrement())
  numero           String @unique
  id_factura       Int
  fecha_emision    DateTime @db.Date
  monto            Decimal @db.Decimal(12,2)
  motivo           String?

  factura factura_proveedor @relation(fields: [id_factura], references: [id_factura])
  detalles detalle_orden_pago[]
}

// 🔹 Notas de débito
model notas_debito {
  id_notas_debito Int    @id @default(autoincrement())
  numero          String @unique
  id_factura      Int
  fecha_emision   DateTime @db.Date
  monto           Decimal @db.Decimal(12,2)
  motivo          String?

  factura factura_proveedor @relation(fields: [id_factura], references: [id_factura])
  detalles detalle_orden_pago[]
}

// 🔹 Ordenes de pago
model ordenes_pago {
  id_ordenes_pago Int      @id @default(autoincrement())
  fecha           DateTime @db.Date
  total           Decimal  @db.Decimal(12,2)

  facturas factura_proveedor[]
  detalles detalle_orden_pago[]
}

// 🔹 Detalle orden de pago
model detalle_orden_pago {
  id_detalles_orden_pago Int @id @default(autoincrement())
  id_orden_pago          Int
  id_nota_credito        Int?
  id_nota_debito         Int?

  orden_pago ordenes_pago @relation(fields: [id_orden_pago], references: [id_ordenes_pago])
  nota_credito notas_credito? @relation(fields: [id_nota_credito], references: [id_notas_credito])
  nota_debito  notas_debito?  @relation(fields: [id_nota_debito], references: [id_notas_debito])
}

// ============================================
// ENUMS NUEVOS
// ============================================
enum tipo_habitacion {
  single
  doble
  suite
}

enum estado_habitacion {
  DISPONIBLE
  OCUPADA
  LIMPIEZA
  MANTENIMIENTO
}

enum estado_reservacion {
  RESERVADA
  CHECKIN
  CHECKOUT
  CANCELADA
}