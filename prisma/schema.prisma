generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categoria {
  id_categoria          Int       @id @default(autoincrement())
  nombre_categoria      String
  descripcion_categoria String?
  activo                Boolean   @default(true)
  fecha_creacion        DateTime? @default(now()) @db.Timestamp(6)
  insumos               insumo[]
}

model insumo {
  id_insumo                 Int                             @id @default(autoincrement())
  nombre_insumo             String
  descripcion_insumo        String?
  activo                    Boolean                         @default(true)
  fecha_actualizacion       DateTime?                       @updatedAt @db.Timestamp(6)
  fecha_creacion            DateTime?                       @default(now()) @db.Timestamp(6)
  id_categoria              Int
  detalle_factura_proveedor detalle_factura_proveedor[]
  detalle_movimientos       detalle_movimiento_inventario[]
  detalle_ordenes           detalle_orden_compra[]
  categoria                 categoria                       @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
  insumo_proveedor          insumo_proveedor[]
  stock_depositos           stock_deposito[]
}

model proveedor {
  id_proveedor         Int                 @id @default(autoincrement())
  nombre_proveedor     String
  cuit_proveedor       String              @unique
  direccion_proveedor  String
  telefono_proveedor   Int?
  correo_proveedor     String?
  nombre_responsable   String?
  contacto_responsable Int?
  activo               Boolean             @default(true)
  observaciones        String?
  fecha_creacion       DateTime?           @default(now()) @db.Timestamp(6)
  fecha_actualizacion  DateTime?           @updatedAt @db.Timestamp(6)
  facturas             factura_proveedor[]
  insumo_proveedor     insumo_proveedor[]
  ordenes_compra       orden_compra[]
}

model deposito {
  id_deposito           Int                     @id @default(autoincrement())
  nombre_deposito       String
  telefono_deposito     Int?
  direccion_deposito    String?
  activo                Boolean                 @default(true)
  fecha_creacion        DateTime?               @default(now()) @db.Timestamp(6)
  id_responsable        Int?
  usuario               usuario?                @relation(fields: [id_responsable], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movimiento_inventario movimiento_inventario[]
  stock_depositos       stock_deposito[]
}

model stock_deposito {
  id_stock         Int       @id @default(autoincrement())
  cantidad_actual  Int       @default(0)
  stock_minimo     Int       @default(0)
  stock_critico    Int       @default(0)
  stock_maximo     Int       @default(0)
  fecha_ultimo_mov DateTime? @db.Timestamp(6)
  id_deposito      Int
  id_insumo        Int
  deposito         deposito  @relation(fields: [id_deposito], references: [id_deposito], onDelete: NoAction, onUpdate: NoAction)
  insumo           insumo    @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_deposito, id_insumo], map: "stock_deposito_id_deposito_id_insumo_idx")
}

model razon_movimiento {
  id_razon        Int                     @id @default(autoincrement())
  nombre_razon    String
  descripcion     String?
  tipo_movimiento tipos_movimiento
  movimientos     movimiento_inventario[]
}

model movimiento_inventario {
  id_movimiento       Int                             @id @default(autoincrement())
  fecha_movimiento    DateTime?                       @default(now()) @db.Timestamp(6)
  numero_comprobante  String?
  observaciones       String?
  id_deposito         Int?
  id_orden_compra     Int?
  id_razon_movimiento Int?
  id_usuario          Int
  detalles            detalle_movimiento_inventario[]
  deposito            deposito?                       @relation(fields: [id_deposito], references: [id_deposito], onDelete: NoAction, onUpdate: NoAction)
  orden_compra        orden_compra?                   @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: NoAction, onUpdate: NoAction)
  razon_movimiento    razon_movimiento?               @relation(fields: [id_razon_movimiento], references: [id_razon], onDelete: NoAction, onUpdate: NoAction)
  usuario             usuario                         @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_movimiento_inventario {
  id_detalle        Int                   @id @default(autoincrement())
  cantidad          Int
  lote              String?
  fecha_vencimiento DateTime?             @db.Timestamp(6)
  id_movimiento     Int
  id_insumo         Int
  insumo            insumo                @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  movimiento        movimiento_inventario @relation(fields: [id_movimiento], references: [id_movimiento], onDelete: NoAction, onUpdate: NoAction)
}

model orden_compra {
  id_orden_compra        Int                     @id @default(autoincrement())
  numero_orden           String                  @unique
  fecha_orden            DateTime                @default(now()) @db.Timestamp(6)
  fecha_entrega_estimada DateTime                @db.Timestamp(6)
  estado_orden           estados_orden           @default(PENDIENTE)
  observaciones          String?
  fecha_actualizacion    DateTime?               @updatedAt @db.Timestamp(6)
  id_proveedor           Int
  id_usuario_solicita    Int
  detalles               detalle_orden_compra[]
  facturas               factura_proveedor[]
  movimientos            movimiento_inventario[]
  proveedor              proveedor               @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
  usuario_solicita       usuario                 @relation(fields: [id_usuario_solicita], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_orden_compra {
  id_detalle_orden    Int          @id @default(autoincrement())
  cantidad_solicitada Int
  id_orden_compra     Int
  id_insumo           Int
  insumo              insumo       @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  orden_compra        orden_compra @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: NoAction, onUpdate: NoAction)
}

model factura_proveedor {
  id_factura                Int                         @id @default(autoincrement())
  numero_factura            String                      @unique
  tipo                      tipo_factura
  fecha_emision             DateTime                    @db.Timestamp(6)
  fecha_vencimiento         DateTime                    @db.Timestamp(6)
  estado_factura            estados_factura             @default(PENDIENTE)
  observaciones             String?
  fecha_creacion            DateTime?                   @default(now()) @db.Timestamp(6)
  fecha_actualizacion       DateTime?                   @updatedAt @db.Timestamp(6)
  id_proveedor              Int
  id_orden_compra           Int?
  detalle_factura_proveedor detalle_factura_proveedor[]
  orden_compra              orden_compra?               @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: NoAction, onUpdate: NoAction)
  proveedor                 proveedor                   @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_factura_proveedor {
  id_detalle_factura Int               @id @default(autoincrement())
  precio             Decimal           @db.Decimal(10,2) @default(0.00)
  cantidad           Int
  id_factura         Int
  id_insumo          Int
  precio             Decimal           @default(0.00) @db.Decimal(10, 2)
  factura_proveedor  factura_proveedor @relation(fields: [id_factura], references: [id_factura], onDelete: NoAction, onUpdate: NoAction)
  insumo             insumo            @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
}

model insumo_proveedor {
  id_insumo_proveedor Int        @id @default(autoincrement())
  id_insumo           Int?
  id_proveedor        Int?
  insumo              insumo?    @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  proveedor           proveedor? @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: NoAction, onUpdate: NoAction)
}

model rol {
  id      Int       @id @default(autoincrement())
  nombre  String    @unique
  usuario usuario[]
}

model usuario {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  contrasena             String
  activo                 Boolean                 @default(true)
  fecha_creacion         DateTime?               @default(now()) @db.Timestamp(6)
  fecha_actualizacion    DateTime?               @db.Timestamp(6)
  id_rol                 Int
  deposito               deposito[]
  movimientos_inventario movimiento_inventario[]
  ordenes_compra         orden_compra[]
  rol                    rol                     @relation(fields: [id_rol], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum estados_factura {
  PENDIENTE
  PAGADA
  VENCIDA
  ANULADA
}

enum estados_orden {
  PENDIENTE
  APROBADA
  RECIBIDA
  CANCELADA
}

enum tipo_factura {
  A
  B
  C
}

enum tipos_movimiento {
  ALTA
  BAJA
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  AJUSTE
}
